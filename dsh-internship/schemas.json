{
  "internship_status": {
    "type": "object",
    "properties": {},
    "required": [],
    "additionalProperties": false
  },
  "internship_profile": {
    "type": "object",
    "properties": {},
    "required": [],
    "additionalProperties": false
  },
  "internship_read_page": {
    "type": "object",
    "properties": {
      "url": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      }
    },
    "required": [
      "url"
    ],
    "additionalProperties": false
  },
  "internship_read_snapshot": {
    "type": "object",
    "properties": {
      "page_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      },
      "offset": {
        "type": "integer",
        "minimum": 0
      }
    },
    "required": [
      "page_id",
      "offset"
    ],
    "additionalProperties": false
  },
  "internship_record": {
    "type": "object",
    "properties": {
      "primary_page_id": {
        "type": "string"
      },
      "title": {
        "type": "string"
      },
      "company": {
        "type": "string"
      },
      "evidence": {
        "type": "array",
        "maxItems": 16,
        "items": {
          "type": "object",
          "properties": {
            "dimension": {
              "type": "string",
              "enum": [
                "work",
                "eligibility",
                "period",
                "attendance",
                "remote",
                "intensity",
                "learning",
                "conversion",
                "skills",
                "pay",
                "benefits",
                "company_context"
              ]
            },
            "fact": {
              "type": "string"
            },
            "quote": {
              "type": "string"
            },
            "page_id": {
              "type": "string"
            }
          },
          "required": [
            "dimension",
            "fact",
            "quote",
            "page_id"
          ],
          "additionalProperties": false
        }
      },
      "analysis": {
        "type": "string"
      },
      "unknowns": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "next_step": {
        "type": "string"
      },
      "reason": {
        "type": "string"
      }
    },
    "required": [
      "primary_page_id",
      "title",
      "company",
      "evidence",
      "analysis",
      "unknowns",
      "next_step",
      "reason"
    ],
    "additionalProperties": false
  },
  "internship_list": {
    "type": "object",
    "properties": {
      "offset": {
        "type": "integer",
        "minimum": 0
      }
    },
    "required": [
      "offset"
    ],
    "additionalProperties": false
  },
  "internship_get": {
    "type": "object",
    "properties": {
      "job_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      }
    },
    "required": [
      "job_id"
    ],
    "additionalProperties": false
  },
  "internship_candidates_plan": {
    "type": "object",
    "properties": {
      "mode": {
        "type": "string",
        "enum": [
          "profile",
          "baseline"
        ],
        "description": "默认profile：按当前档案；baseline：固定广州查询用于对比"
      },
      "extra_queries": {
        "type": "array",
        "maxItems": 8,
        "items": {
          "type": "string",
          "maxLength": 80
        },
        "description": "DSH根据用户目标补充的查询，含实习；不要包含个人身份信息"
      }
    },
    "required": [],
    "additionalProperties": false
  },
  "internship_candidates_add": {
    "type": "object",
    "properties": {
      "query": {
        "type": "string",
        "maxLength": 300
      },
      "urls": {
        "type": "array",
        "maxItems": 20,
        "items": {
          "type": "string",
          "maxLength": 2048
        }
      },
      "error": {
        "type": "string",
        "maxLength": 500
      }
    },
    "required": [
      "query",
      "urls",
      "error"
    ],
    "additionalProperties": false
  },
  "internship_candidates_check": {
    "type": "object",
    "properties": {
      "candidate_id": {
        "type": "string",
        "maxLength": 100
      }
    },
    "required": [
      "candidate_id"
    ],
    "additionalProperties": false
  },
  "internship_candidates_report": {
    "type": "object",
    "properties": {},
    "required": [],
    "additionalProperties": false
  },
  "internship_candidates_view": {
    "type": "object",
    "properties": {},
    "required": [],
    "additionalProperties": false
  },
  "internship_candidates_recheck": {
    "type": "object",
    "properties": {
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 20
      }
    },
    "required": [],
    "additionalProperties": false
  },
  "internship_profile_propose": {
    "type": "object",
    "properties": {
      "base_version": {
        "type": "string",
        "minLength": 64,
        "maxLength": 64
      },
      "changes": {
        "type": "object",
        "properties": {
          "stage": {
            "type": "string",
            "maxLength": 4000
          },
          "background": {
            "type": "string",
            "maxLength": 4000
          },
          "growth_goal": {
            "type": "string",
            "maxLength": 4000
          },
          "additional_constraints": {
            "type": "string",
            "maxLength": 4000
          },
          "skills_known": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 500
            },
            "maxItems": 40
          },
          "skills_learning": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 500
            },
            "maxItems": 40
          },
          "cities": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 500
            },
            "maxItems": 40
          },
          "keywords": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 500
            },
            "maxItems": 40
          },
          "priorities": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 500
            },
            "maxItems": 40
          },
          "hard_constraints": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 500
            },
            "maxItems": 40
          },
          "accepted_degree_labels": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 500
            },
            "maxItems": 40
          },
          "days_per_week": {
            "type": "integer",
            "minimum": 0,
            "maximum": 7
          },
          "months": {
            "type": "integer",
            "minimum": 0,
            "maximum": 120
          }
        },
        "additionalProperties": false
      },
      "clear_fields": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "stage",
            "background",
            "growth_goal",
            "additional_constraints",
            "skills_known",
            "skills_learning",
            "cities",
            "keywords",
            "priorities",
            "hard_constraints",
            "accepted_degree_labels",
            "days_per_week",
            "months"
          ]
        },
        "maxItems": 13
      },
      "restore_previous": {
        "type": "string",
        "enum": [
          "yes",
          "no"
        ]
      },
      "reason": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    },
    "required": [
      "base_version",
      "reason"
    ],
    "additionalProperties": false
  },
  "internship_profile_apply": {
    "type": "object",
    "properties": {
      "draft_id": {
        "type": "string",
        "minLength": 32,
        "maxLength": 32
      },
      "confirmation": {
        "type": "string",
        "enum": [
          "user_confirmed"
        ]
      }
    },
    "required": [
      "draft_id",
      "confirmation"
    ],
    "additionalProperties": false
  }
}
